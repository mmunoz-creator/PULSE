<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PULSE Strategy</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<style>
:root{
  /* Shared PULSE family tokens, matched to PULSE Pricing's live CSS
     custom properties (read via getComputedStyle on elevatorpulse.com/pricing) */
  --navy:#0a1628;
  --navy-2:#0d1b2e;
  --paper:#fafafa;
  --paper-raised:#FFFFFF;
  --paper-sunk:#f6f7f8;
  --border:#e3e6ea;
  --border-strong:#d0d5db;
  --text:#14181f;
  --text-muted:#4d5560;
  --text-faint:#8a919c;

  /* PULSE Strategy's own accent, per continuity brief §12 */
  --accent:#4a3aa7;
  --accent-soft:#f1edfb;
  --accent-ink:#3a2d86;

  --good:#1a8a4a;
  --good-soft:#e3f7ea;
  --warn:#8a5c00;
  --warn-soft:#fff3da;
  --crit:#a32a2a;
  --crit-soft:#fbe9e9;
  --shadow: 0 1px 2px rgba(10,22,40,0.05), 0 8px 24px -12px rgba(10,22,40,0.14);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --navy:#070d18; --navy-2:#0a1220; --paper:#0b0f18; --paper-raised:#121826; --paper-sunk:#161d2e;
    --border:#232b3d; --border-strong:#333d54; --text:#e7e9ee; --text-muted:#9aa1b3; --text-faint:#6b7385;
    --accent:#8a78e8; --accent-soft:#221d47; --accent-ink:#b0a2f2;
    --good:#4fcb8e; --good-soft:#0f2e21; --warn:#d9a53f; --warn-soft:#332508; --crit:#e3707c; --crit-soft:#361419;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.55);
  }
}
:root[data-theme="dark"]{
  --navy:#070d18; --navy-2:#0a1220; --paper:#0b0f18; --paper-raised:#121826; --paper-sunk:#161d2e;
  --border:#232b3d; --border-strong:#333d54; --text:#e7e9ee; --text-muted:#9aa1b3; --text-faint:#6b7385;
  --accent:#8a78e8; --accent-soft:#221d47; --accent-ink:#b0a2f2;
  --good:#4fcb8e; --good-soft:#0f2e21; --warn:#d9a53f; --warn-soft:#332508; --crit:#e3707c; --crit-soft:#361419;
  --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.55);
}

*{box-sizing:border-box}
body{
  margin:0; background:var(--paper); color:var(--text);
  font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  font-variant-numeric:tabular-nums;
}
h1,h2,h3{text-wrap:balance; margin:0}
.hidden{display:none !important}

/* ================= LOGIN ================= */
.login-wrap{
  min-height:100vh; display:flex; align-items:center; justify-content:center;
  padding:40px 20px; background:var(--paper);
}
.login-card{
  width:100%; max-width:920px; display:grid; grid-template-columns:1.05fr 1fr;
  background:var(--paper-raised); border:1px solid var(--border); border-radius:16px;
  overflow:hidden; box-shadow:var(--shadow);
}
.login-brand{
  background:linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
  color:#EDEDF2; padding:44px 40px; display:flex; flex-direction:column; justify-content:space-between;
  position:relative; overflow:hidden;
}
.login-brand::after{
  content:""; position:absolute; inset:auto -25% -45% auto; width:75%; height:75%;
  background:radial-gradient(closest-side, var(--accent) 0%, transparent 70%);
  opacity:.22;
}
.brand-mark{display:flex; align-items:center; gap:10px; position:relative; z-index:1}
.brand-mark .mark-tile{
  width:34px; height:34px; border-radius:9px; background:var(--accent);
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.brand-word{font-size:19px; font-weight:800; letter-spacing:-.005em}
.brand-word .accent-word{color:var(--accent-ink); font-weight:800}
.brand-mid{position:relative; z-index:1; margin-top:48px}
.brand-mid h2{font-size:26px; line-height:1.28; font-weight:700; color:#fff}
.brand-mid .accent-line{color:var(--accent-ink)}
.brand-mid .rule{width:36px; height:3px; background:var(--accent); border-radius:2px; margin:14px 0 16px}
.brand-mid p{font-size:14px; line-height:1.65; color:#b7bcd4; margin-top:0; max-width:32ch}
.brand-foot{position:relative; z-index:1; font-size:11px; color:#6b7290}

.login-form{padding:44px 40px; display:flex; flex-direction:column; justify-content:center}
.login-form h1{font-size:22px; font-weight:700}
.login-form .sub{font-size:13px; color:var(--text-muted); margin-top:5px; margin-bottom:26px}
.field{margin-bottom:16px}
.field label{display:block; font-size:11.5px; font-weight:700; letter-spacing:.03em; color:var(--text-muted); margin-bottom:6px; text-transform:uppercase}
.field input{
  width:100%; font-family:inherit; font-size:14px; padding:11px 13px; border-radius:8px;
  border:1.5px solid var(--border-strong); background:var(--paper); color:var(--text); outline:none;
}
.field input:focus{border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft)}
.btn-primary{
  width:100%; font-family:inherit; font-size:14px; font-weight:700; padding:12px; border-radius:8px;
  border:none; cursor:pointer; background:var(--accent); color:#fff; margin-top:6px;
}
.btn-primary:hover{background:var(--accent-ink)}
.btn-primary:disabled{opacity:.6; cursor:default}
.login-foot{margin-top:22px; font-size:11.5px; color:var(--text-faint)}
.form-error{
  font-size:12.5px; color:var(--crit); background:var(--crit-soft); border-radius:8px; padding:9px 12px;
  margin-top:4px; display:none;
}
.form-error.show{display:block}

/* ================= APP SHELL ================= */
.app{display:grid; grid-template-columns:232px 1fr; min-height:100vh}
.rail{
  background:var(--navy); color:#c7cbdc; padding:20px 14px; display:flex; flex-direction:column;
  border-right:1px solid var(--border);
}
.rail-brand{display:flex; align-items:center; gap:9px; padding:6px 8px 22px}
.rail-brand .mark-tile{width:28px; height:28px; border-radius:8px; background:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;}
.rail-brand .brand-word{font-size:15px; color:#fff}
.rail-item{
  display:flex; align-items:center; gap:10px; padding:9px 10px; border-radius:8px; font-size:13px;
  font-weight:600; color:#b9bed1; cursor:pointer; margin-bottom:2px;
}
.rail-item svg{opacity:.8; flex-shrink:0}
.rail-item.active{background:var(--accent); color:#fff}
.rail-item.active svg{opacity:1}
.rail-item:not(.active):hover{background:rgba(255,255,255,0.06)}
.rail-item.disabled{opacity:.42; cursor:default}
.rail-item.disabled:hover{background:transparent}
.rail-spacer{flex:1}
.rail-badge{
  display:inline-block; font-size:9.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
  padding:3px 8px; border-radius:5px; background:var(--warn-soft); color:var(--warn); margin:4px 8px 14px;
  width:fit-content;
}
.rail-user{
  display:flex; align-items:center; gap:9px; padding:10px; border-radius:10px; background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.08); cursor:pointer;
}
.rail-avatar{
  width:30px; height:30px; border-radius:8px; background:var(--accent); color:#fff; display:flex;
  align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0;
}
.rail-user-name{font-size:12.5px; font-weight:700; color:#fff}
.rail-user-role{font-size:10.5px; color:#7c839c}

.main{padding:26px 32px 60px; overflow-x:hidden}
.topbar{display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22px; gap:20px}
.topbar h1{font-size:20px; font-weight:700}
.topbar .eyebrow{font-size:11px; font-weight:700; letter-spacing:.1em; color:var(--accent-ink); text-transform:uppercase; margin-bottom:4px}
.topbar .period{font-size:12.5px; color:var(--text-muted); margin-top:4px}

.card{
  background:var(--paper-raised); border:1px solid var(--border); border-radius:12px;
  box-shadow:var(--shadow); overflow:hidden;
}
.card-head{display:flex; align-items:baseline; justify-content:space-between; padding:16px 18px 4px; flex-wrap:wrap; gap:8px}
.card-head h3{font-size:14px; font-weight:700}
.card-head .meta{font-size:11px; color:var(--text-faint); font-weight:600}
.card-pad{padding:14px 18px 18px}

.rtable{width:100%; border-collapse:collapse; font-size:12.5px}
.rtable th{
  text-align:left; font-size:10.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
  color:var(--text-faint); padding:0 10px 8px; border-bottom:1px solid var(--border);
}
.rtable td{padding:9px 10px; border-bottom:1px solid var(--border)}
.rtable tr:last-child td{border-bottom:none}
.rtable td.num, .rtable th.num{text-align:right}
.region-name{font-weight:700}

/* Baseline view */
.subtabs{display:flex; gap:4px; padding:4px; background:var(--paper-sunk); border-radius:11px; margin-bottom:18px; width:fit-content}
.subtab{
  font-family:inherit; font-size:12.5px; font-weight:700; padding:8px 16px; border-radius:8px; border:none;
  background:transparent; color:var(--text-muted); cursor:pointer; white-space:nowrap;
}
.subtab.active{background:var(--paper-raised); color:var(--accent-ink); box-shadow:0 1px 3px rgba(10,22,40,0.1)}
.subpane{display:none}
.subpane.active{display:block}

.year-picker{display:flex; align-items:center; gap:8px; font-size:12px; font-weight:600; color:var(--text-muted)}
.year-picker select{
  font-family:inherit; font-size:13px; font-weight:700; color:var(--text); padding:7px 10px; border-radius:8px;
  border:1.5px solid var(--border-strong); background:var(--paper-raised);
}
.budget-cell-input{
  width:100px; text-align:right; font-family:inherit; font-variant-numeric:tabular-nums; font-size:12.5px;
  font-weight:700; padding:6px 8px; border-radius:6px; border:1.5px solid transparent; background:transparent;
  color:var(--text); transition:border-color .1s, background .1s;
}
.budget-cell-input:hover{border-color:var(--border-strong); background:var(--paper-sunk)}
.budget-cell-input:focus{border-color:var(--accent); background:var(--paper-raised); outline:none; box-shadow:0 0 0 3px var(--accent-soft)}
.budget-cell-input.saved{border-color:var(--good)}
.region-total-cell{font-weight:800; color:var(--text)}
.budget-grand-row td{font-weight:800; border-top:2px solid var(--border-strong); border-bottom:none; padding-top:12px}
.budget-hint{font-size:11.5px; color:var(--text-faint); margin-top:12px; line-height:1.5}

.geo-name-input{
  width:100%; max-width:220px; font-family:inherit; font-size:13px; font-weight:700; color:var(--text);
  padding:7px 9px; border-radius:7px; border:1.5px solid transparent; background:transparent;
  transition:border-color .1s, background .1s;
}
.geo-name-input:hover{border-color:var(--border-strong); background:var(--paper-sunk)}
.geo-name-input:focus{border-color:var(--accent); background:var(--paper-raised); outline:none; box-shadow:0 0 0 3px var(--accent-soft)}
.geo-badge{font-size:10.5px; font-weight:700; padding:3px 8px; border-radius:999px; background:var(--accent-soft); color:var(--accent-ink)}

.toast{
  position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:var(--navy); color:#fff;
  font-size:13px; font-weight:600; padding:11px 18px; border-radius:10px; box-shadow:var(--shadow);
  z-index:200; opacity:0; pointer-events:none; transition:opacity .2s;
}
.toast.show{opacity:1}
.toast.error{background:var(--crit)}

.placeholder-card{
  background:var(--paper-raised); border:1px dashed var(--border-strong); border-radius:12px;
  padding:40px; text-align:center; color:var(--text-faint); font-size:13px;
}
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<div class="login-wrap" id="login-screen">
  <div class="login-card">
    <div class="login-brand">
      <div>
        <div class="brand-mark">
          <div class="mark-tile">
            <svg width="18" height="18" viewBox="0 0 26 26" fill="none"><path d="M2 14h5l2.5-7 4 14 3-10 2 3h5.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="brand-word">PULSE <span class="accent-word">Strategy</span></div>
        </div>
        <div class="brand-mid">
          <h2>Insight today.<br><span class="accent-line">Advantage tomorrow.</span></h2>
          <div class="rule"></div>
          <p>PULSE Strategy delivers the intelligence you need to make confident decisions, drive performance, and create measurable impact.</p>
        </div>
      </div>
      <div class="brand-foot">Server-verified session &middot; VDA internal use only</div>
    </div>
    <div class="login-form">
      <h1>Sign in</h1>
      <div class="sub">Enter your name and PIN to continue.</div>

      <div class="field">
        <label>Name</label>
        <input type="text" id="loginName" placeholder="First and last name" autocomplete="username">
      </div>
      <div class="field">
        <label>PIN</label>
        <input type="password" id="loginPin" placeholder="Enter your PIN" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()">
        <div class="form-error" id="login-error"></div>
      </div>
      <button class="btn-primary" id="loginBtn" onclick="doLogin()">Sign in</button>

      <div class="login-foot">Having trouble? Contact your PULSE administrator.</div>
    </div>
  </div>
</div>

<!-- ============ RESET PIN (first login / admin reset) ============ -->
<div class="login-wrap hidden" id="reset-pin-screen">
  <div class="login-card">
    <div class="login-brand">
      <div>
        <div class="brand-mark">
          <div class="mark-tile">
            <svg width="18" height="18" viewBox="0 0 26 26" fill="none"><path d="M2 14h5l2.5-7 4 14 3-10 2 3h5.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="brand-word">PULSE <span class="accent-word">Strategy</span></div>
        </div>
        <div class="brand-mid">
          <h2>Almost there.<br><span class="accent-line">Choose your PIN.</span></h2>
        </div>
      </div>
    </div>
    <div class="login-form">
      <h1>Set your PIN</h1>
      <div class="sub" id="reset-pin-welcome">You signed in with a one-time PIN. Choose your own permanent one now.</div>

      <div class="field">
        <label>New PIN (at least 6 characters, letters &amp; numbers)</label>
        <input type="password" id="newPermanentPin" placeholder="Choose a PIN" autocomplete="new-password">
      </div>
      <div class="field">
        <label>Confirm New PIN</label>
        <input type="password" id="confirmPermanentPin" placeholder="Re-enter your PIN" autocomplete="new-password" onkeydown="if(event.key==='Enter')submitNewPermanentPin()">
        <div class="form-error" id="reset-pin-error"></div>
      </div>
      <button class="btn-primary" id="resetPinSubmitBtn" onclick="submitNewPermanentPin()">Set PIN &amp; Continue</button>
    </div>
  </div>
</div>

<!-- ============ APP SHELL ============ -->
<div class="app hidden" id="app-root">
  <div class="rail">
    <div class="rail-brand">
      <div class="mark-tile">
        <svg width="15" height="15" viewBox="0 0 26 26" fill="none"><path d="M2 14h5l2.5-7 4 14 3-10 2 3h5.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="brand-word">PULSE <span class="accent-word" style="color:#c9beff">Strategy</span></div>
    </div>
    <div class="rail-badge">Admin</div>

    <div class="rail-item disabled" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
      Executive Summary
    </div>
    <div class="rail-item disabled" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V9M10 21V3M17 21v-7"/></svg>
      Regions
    </div>
    <div class="rail-item disabled" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
      Forecast
    </div>
    <div class="rail-item disabled" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
      Pipeline &amp; Backlog
    </div>
    <div class="rail-item active" data-view="baseline" onclick="showView('baseline',this)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/></svg>
      Baseline
    </div>

    <div class="rail-item disabled" style="margin-top:14px" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Manage Users
    </div>
    <div class="rail-item disabled" title="Not yet built in this pass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Weekly Uploads
    </div>

    <div class="rail-spacer"></div>
    <div class="rail-user" id="railUser" onclick="doLogout()" title="Sign out">
      <div class="rail-avatar" id="railAvatar">--</div>
      <div>
        <div class="rail-user-name" id="railUserName">--</div>
        <div class="rail-user-role" id="railUserRole">--</div>
      </div>
    </div>
  </div>

  <!-- ---- Baseline (the only real screen wired this pass) ---- -->
  <div class="main" id="view-baseline">
    <div class="topbar">
      <div>
        <div class="eyebrow">Admin, Editable</div>
        <h1>Baseline</h1>
        <div class="period">Targets, territory, and next year's plan: the numbers everything else measures against</div>
      </div>
    </div>

    <div class="subtabs">
      <button class="subtab active" data-subtab="revenue" onclick="showBaselineTab('revenue',this)">Revenue Budgets</button>
      <button class="subtab" data-subtab="sales" onclick="showBaselineTab('sales',this)">Sales Budgets</button>
      <button class="subtab" data-subtab="geography" onclick="showBaselineTab('geography',this)">Geography</button>
    </div>

    <!-- Revenue Budgets -->
    <div class="subpane active" id="subpane-revenue">
      <div class="card">
        <div class="card-head">
          <h3>Revenue Budget by Region and Line of Business</h3>
          <div style="display:flex; align-items:center; gap:12px">
            <span class="meta" id="revenue-total-meta">&mdash;</span>
            <label class="year-picker">
              <span>Year</span>
              <select id="revenue-year-select" onchange="onBudgetYearChange('revenue', this.value)">
                <option value="2026">2026</option>
                <option value="2027">2027</option>
              </select>
            </label>
          </div>
        </div>
        <div class="card-pad" style="padding-top:6px">
          <div style="overflow-x:auto">
            <table class="rtable" id="revenue-table">
              <thead>
                <tr>
                  <th>Region</th>
                  <th class="num">Program Advisory</th>
                  <th class="num">Design Services</th>
                  <th class="num">Inspections</th>
                  <th class="num">Region Total</th>
                </tr>
              </thead>
              <tbody id="revenue-tbody"></tbody>
              <tfoot>
                <tr class="budget-grand-row">
                  <td>Company Total</td>
                  <td class="num" id="revenue-gt-program_advisory">&mdash;</td>
                  <td class="num" id="revenue-gt-design_services">&mdash;</td>
                  <td class="num" id="revenue-gt-inspections">&mdash;</td>
                  <td class="num" id="revenue-gt-all">&mdash;</td>
                </tr>
              </tfoot>
            </table>
          </div>
          <div class="budget-hint">Billings target: what we plan to recognize as revenue this year. Editing saves immediately to the server; shared across every admin viewing this page.</div>
        </div>
      </div>
    </div>

    <!-- Sales Budgets -->
    <div class="subpane" id="subpane-sales">
      <div class="card">
        <div class="card-head">
          <h3>Sales Budget by Region and Line of Business</h3>
          <div style="display:flex; align-items:center; gap:12px">
            <span class="meta" id="sales-total-meta">&mdash;</span>
            <label class="year-picker">
              <span>Year</span>
              <select id="sales-year-select" onchange="onBudgetYearChange('sales', this.value)">
                <option value="2026">2026</option>
                <option value="2027">2027</option>
              </select>
            </label>
          </div>
        </div>
        <div class="card-pad" style="padding-top:6px">
          <div style="overflow-x:auto">
            <table class="rtable" id="sales-table">
              <thead>
                <tr>
                  <th>Region</th>
                  <th class="num">Program Advisory</th>
                  <th class="num">Design Services</th>
                  <th class="num">Inspections</th>
                  <th class="num">Region Total</th>
                </tr>
              </thead>
              <tbody id="sales-tbody"></tbody>
              <tfoot>
                <tr class="budget-grand-row">
                  <td>Company Total</td>
                  <td class="num" id="sales-gt-program_advisory">&mdash;</td>
                  <td class="num" id="sales-gt-design_services">&mdash;</td>
                  <td class="num" id="sales-gt-inspections">&mdash;</td>
                  <td class="num" id="sales-gt-all">&mdash;</td>
                </tr>
              </tfoot>
            </table>
          </div>
          <div class="budget-hint">Bookings target: new business we plan to sign this year. Editing saves immediately to the server; shared across every admin viewing this page.</div>
        </div>
      </div>
    </div>

    <!-- Geography -->
    <div class="subpane" id="subpane-geography">
      <div class="card">
        <div class="card-head">
          <h3>Regions</h3>
          <span class="meta">Rename in place: every screen that groups by region follows the new name</span>
        </div>
        <div class="card-pad" style="padding-top:6px">
          <div style="overflow-x:auto">
            <table class="rtable" id="geo-table">
              <thead>
                <tr>
                  <th style="width:260px">Region Name</th>
                  <th>Type</th>
                </tr>
              </thead>
              <tbody id="geo-tbody"></tbody>
            </table>
          </div>
          <div class="budget-hint">Renaming a region updates its name everywhere: Revenue Budgets, Sales Budgets, and every other screen that groups by region resolve against this list rather than a fixed name. Canada and UK are placeholder regions, included now for future Salesforce data.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   AUTH — real server-side session against the live Worker, same
   pattern as PULSE Pricing (read directly from its real source,
   Pulse_Pricing_v2q.md, not reinvented). See continuity brief §26.
   ============================================================ */
const APP_VERSION = 'v1';

// Confirmed 2026-09-03 against the real deployed Worker (Cloudflare
// Overview page): this is the live URL, not a placeholder.
const WORKER_URL = 'https://pulse-strategy-api.misty-munoz.workers.dev';

let sessionToken = null;
let currentUser = null; // { id, name, role }
let pendingResetToken = null;

const SESSION_STORAGE_KEY = 'pulse_strategy_session';
function saveSessionToStorage(){
  try { sessionStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({ token: sessionToken, user: currentUser })); }
  catch(e){ /* sessionStorage unavailable, session restore just won't work */ }
}
function clearSessionStorage(){
  try { sessionStorage.removeItem(SESSION_STORAGE_KEY); } catch(e){}
}
function tryRestoreSession(){
  let saved = null;
  try {
    const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
    if (raw) saved = JSON.parse(raw);
  } catch(e){ return false; }
  if (!saved || !saved.token || !saved.user) return false;
  sessionToken = saved.token;
  currentUser = saved.user;
  showApp();
  return true;
}

async function workerFetch(path, opts = {}) {
  const o = { ...opts };
  o.headers = { ...(o.headers || {}) };
  if (sessionToken) o.headers['Authorization'] = 'Bearer ' + sessionToken;
  const res = await fetch(WORKER_URL + path, o);
  if (res.status === 401 && path !== '/login' && path !== '/api/auth/set-pin') {
    sessionToken = null; currentUser = null; pendingResetToken = null;
    clearSessionStorage();
    document.getElementById('app-root').classList.add('hidden');
    document.getElementById('reset-pin-screen').classList.add('hidden');
    document.getElementById('login-screen').classList.remove('hidden');
  }
  return res;
}

function setLoginError(message) {
  const el = document.getElementById('login-error');
  if (message) { el.textContent = message; el.classList.add('show'); }
  else { el.textContent = ''; el.classList.remove('show'); }
}

function setResetPinError(message) {
  const el = document.getElementById('reset-pin-error');
  if (message) { el.textContent = message; el.classList.add('show'); }
  else { el.textContent = ''; el.classList.remove('show'); }
}

async function doLogin() {
  const name = document.getElementById('loginName').value.trim();
  const pin = document.getElementById('loginPin').value.trim();
  setLoginError(null);
  if (!name || !pin) { setLoginError('Enter your name and PIN to continue.'); return; }

  const btn = document.getElementById('loginBtn');
  btn.disabled = true;
  try {
    const res = await fetch(WORKER_URL + '/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, pin }),
    });
    const data = await res.json();
    if (!res.ok) { setLoginError(data.error || 'Sign in failed. Try again.'); return; }

    if (data.mustResetPin) {
      pendingResetToken = data.resetToken;
      document.getElementById('reset-pin-welcome').textContent =
        `Hi ${data.user.name}, you signed in with a one-time PIN. Choose your own permanent one now.`;
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('reset-pin-screen').classList.remove('hidden');
      return;
    }
    if (!data.token) { setLoginError(data.error || 'Sign in failed. Try again.'); return; }
    if (data.user.role !== 'admin') {
      setLoginError('This account is not set up for PULSE Strategy. Contact your admin.');
      return;
    }
    sessionToken = data.token;
    currentUser = data.user;
    saveSessionToStorage();
    showApp();
  } catch (e) {
    setLoginError('Could not reach the server. Check your connection and try again.');
  } finally {
    btn.disabled = false;
  }
}

async function submitNewPermanentPin() {
  const newPin = document.getElementById('newPermanentPin').value.trim();
  const confirmPin = document.getElementById('confirmPermanentPin').value.trim();
  setResetPinError(null);
  if (!newPin || newPin.length < 6) { setResetPinError('PIN must be at least 6 characters.'); return; }
  if (!/[a-zA-Z]/.test(newPin) || !/[0-9]/.test(newPin)) { setResetPinError('PIN must contain at least one letter and one number.'); return; }
  if (newPin !== confirmPin) { setResetPinError('PINs do not match.'); return; }

  const btn = document.getElementById('resetPinSubmitBtn');
  btn.disabled = true;
  try {
    const res = await fetch(WORKER_URL + '/api/auth/set-pin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ resetToken: pendingResetToken, newPin }),
    });
    const data = await res.json();
    if (!res.ok || !data.token) { setResetPinError(data.error || 'Could not set your PIN. Try again.'); return; }
    pendingResetToken = null;
    if (data.user.role !== 'admin') {
      setResetPinError('This account is not set up for PULSE Strategy. Contact your admin.');
      return;
    }
    sessionToken = data.token;
    currentUser = data.user;
    saveSessionToStorage();
    document.getElementById('reset-pin-screen').classList.add('hidden');
    showApp();
  } catch (e) {
    setResetPinError('Could not reach the server. Check your connection and try again.');
  } finally {
    btn.disabled = false;
  }
}

async function doLogout(){
  try { await workerFetch('/logout', { method: 'POST' }); } catch(e){}
  sessionToken = null; currentUser = null;
  clearSessionStorage();
  document.getElementById('app-root').classList.add('hidden');
  document.getElementById('login-screen').classList.remove('hidden');
}

function showApp(){
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('reset-pin-screen').classList.add('hidden');
  document.getElementById('app-root').classList.remove('hidden');
  const initials = currentUser.name.split(' ').map(p=>p[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('railAvatar').textContent = initials;
  document.getElementById('railUserName').textContent = currentUser.name;
  document.getElementById('railUserRole').textContent = currentUser.role === 'admin' ? 'Admin' : currentUser.role;
  loadRegions().then(() => {
    loadBudgetYear('revenue', 2026);
    loadBudgetYear('sales', 2026);
    renderGeoTable();
  });
}

function showView(view, el){
  document.querySelectorAll('.rail-item').forEach(i=>i.classList.remove('active'));
  if (el) el.classList.add('active');
  // Only Baseline is wired this pass; other rail items are disabled.
}

/* ============================================================
   TOAST
   ============================================================ */
let toastTimer = null;
function showToast(message, isError){
  const el = document.getElementById('toast');
  el.textContent = message;
  el.classList.toggle('error', !!isError);
  el.classList.add('show');
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>el.classList.remove('show'), 3200);
}

/* ============================================================
   BASELINE — Regions (Geography tab)
   ============================================================ */
let REGIONS = []; // [{id, name, sort_order, is_placeholder}], loaded from server

async function loadRegions(){
  try {
    const res = await workerFetch('/api/regions');
    const data = await res.json();
    REGIONS = (data.regions || []).sort((a,b)=>a.sort_order-b.sort_order);
  } catch(e){
    showToast('Could not load regions from the server.', true);
    REGIONS = [];
  }
}

function renderGeoTable(){
  const tbody = document.getElementById('geo-tbody');
  tbody.innerHTML = '';
  REGIONS.forEach(region=>{
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input class="geo-name-input" type="text" value="${escapeHtml(region.name)}"
          data-region-id="${region.id}" onchange="onRegionNameChange(this)"></td>
      <td>${region.is_placeholder ? '<span class="geo-badge">Placeholder, no live data yet</span>' : 'Active'}</td>
    `;
    tbody.appendChild(tr);
  });
}

async function onRegionNameChange(input){
  const regionId = input.dataset.regionId;
  const newName = input.value.trim();
  if (!newName) { showToast('Region name cannot be empty.', true); renderGeoTable(); return; }
  try {
    const res = await workerFetch(`/api/regions/${regionId}`, {
      method: 'PATCH', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ name: newName }),
    });
    const data = await res.json();
    if (!res.ok) { showToast(data.error || 'Could not rename region.', true); renderGeoTable(); return; }
    const region = REGIONS.find(r=>r.id===regionId);
    if (region) region.name = newName;
    showToast('Region renamed. Every screen that groups by region now reflects it.');
    // Region names are read live off REGIONS by the budget tables, so
    // just re-render them in place rather than refetching amounts.
    renderBudgetTable('revenue', lastBudgetRows.revenue);
    renderBudgetTable('sales', lastBudgetRows.sales);
  } catch(e){
    showToast('Could not reach the server.', true); renderGeoTable();
  }
}

/* ============================================================
   BASELINE — Revenue Budgets / Sales Budgets
   ============================================================ */
const LOBS = [
  { key: 'program_advisory', label: 'Program Advisory' },
  { key: 'design_services', label: 'Design Services' },
  { key: 'inspections', label: 'Inspections' },
];
let currentYear = { revenue: 2026, sales: 2026 };
let lastBudgetRows = { revenue: [], sales: [] };

function fmtMoney(n){
  if (!n && n !== 0) return '&mdash;';
  return '$' + Math.round(n).toLocaleString('en-US');
}

async function loadBudgetYear(kind, year){
  currentYear[kind] = year;
  document.getElementById(kind + '-year-select').value = year;
  try {
    const res = await workerFetch(`/api/baseline/${kind}-budgets?fiscalYear=${year}`);
    const data = await res.json();
    lastBudgetRows[kind] = data.rows || [];
    renderBudgetTable(kind, lastBudgetRows[kind]);
  } catch(e){
    showToast('Could not load budget data from the server.', true);
    lastBudgetRows[kind] = [];
    renderBudgetTable(kind, []);
  }
}

function onBudgetYearChange(kind, year){ loadBudgetYear(kind, parseInt(year, 10)); }

// rows come back from the server as flat {region_id, line_of_business,
// fiscal_year, amount} records; pivot into {regionId: {lobKey: amount}}
// for rendering.
function pivotRows(rows){
  const byRegion = {};
  rows.forEach(r=>{
    if (!byRegion[r.region_id]) byRegion[r.region_id] = {};
    byRegion[r.region_id][r.line_of_business] = r.amount;
  });
  return byRegion;
}

function renderBudgetTable(kind, rows){
  const data = pivotRows(rows);
  const tbody = document.getElementById(kind + '-tbody');
  tbody.innerHTML = '';
  let totals = { program_advisory: 0, design_services: 0, inspections: 0 };
  REGIONS.forEach(region=>{
    const row = data[region.id] || {};
    const regionTotal = (row.program_advisory||0) + (row.design_services||0) + (row.inspections||0);
    LOBS.forEach(l => totals[l.key] += (row[l.key]||0));
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="region-name">${escapeHtml(region.name)}</td>
      ${LOBS.map(l => `<td><input class="budget-cell-input" type="number" step="1000"
          data-kind="${kind}" data-region="${region.id}" data-lob="${l.key}" value="${row[l.key]||0}"
          onchange="onBudgetCellChange(this)"></td>`).join('')}
      <td class="num region-total-cell" data-kind="${kind}" data-region-total="${region.id}">${fmtMoney(regionTotal)}</td>
    `;
    tbody.appendChild(tr);
  });
  const grandTotal = totals.program_advisory + totals.design_services + totals.inspections;
  LOBS.forEach(l => { document.getElementById(kind+'-gt-'+l.key).innerHTML = fmtMoney(totals[l.key]); });
  document.getElementById(kind+'-gt-all').innerHTML = fmtMoney(grandTotal);
  const label = kind === 'revenue' ? 'Billings target' : 'Bookings target';
  document.getElementById(kind+'-total-meta').textContent = label + ', FY' + currentYear[kind] + ': ' + fmtMoney(grandTotal).replace('&mdash;','—');
}

async function onBudgetCellChange(input){
  const kind = input.dataset.kind;
  const regionId = input.dataset.region;
  const lob = input.dataset.lob;
  const amount = parseFloat(input.value) || 0;

  // Recompute totals from live DOM values immediately, don't wait on the
  // network round-trip.
  recomputeBudgetTotalsFromDom(kind);
  input.classList.add('saved');
  setTimeout(()=>input.classList.remove('saved'), 900);

  try {
    const res = await workerFetch(`/api/baseline/${kind}-budgets`, {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ regionId, lineOfBusiness: lob, fiscalYear: currentYear[kind], amount }),
    });
    const data = await res.json();
    if (!res.ok) { showToast(data.error || 'Could not save. Your change was not kept.', true); }
  } catch(e){
    showToast('Could not reach the server. Your change was not kept.', true);
  }
}

function recomputeBudgetTotalsFromDom(kind){
  let totals = { program_advisory: 0, design_services: 0, inspections: 0 };
  REGIONS.forEach(region=>{
    let sum = 0;
    document.querySelectorAll(`.budget-cell-input[data-kind="${kind}"][data-region="${region.id}"]`).forEach(inp=>{
      const v = parseFloat(inp.value) || 0;
      sum += v;
      totals[inp.dataset.lob] += v;
    });
    const cell = document.querySelector(`[data-kind="${kind}"][data-region-total="${region.id}"]`);
    if (cell) cell.textContent = fmtMoney(sum);
  });
  const grandTotal = totals.program_advisory + totals.design_services + totals.inspections;
  LOBS.forEach(l => { document.getElementById(kind+'-gt-'+l.key).innerHTML = fmtMoney(totals[l.key]); });
  document.getElementById(kind+'-gt-all').innerHTML = fmtMoney(grandTotal);
  const label = kind === 'revenue' ? 'Billings target' : 'Bookings target';
  document.getElementById(kind+'-total-meta').textContent = label + ', FY' + currentYear[kind] + ': ' + fmtMoney(grandTotal).replace('&mdash;','—');
}

function showBaselineTab(name, btn){
  document.querySelectorAll('.subtab').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.subpane').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('subpane-' + name).classList.add('active');
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ============================================================
   BOOT
   ============================================================ */
if (!tryRestoreSession()) {
  // Login screen already visible by default.
}
</script>
</body>
</html>
